# WebAI Frontend Configuration
# Copy this file to .env.local and fill in your values

# Required: WebAI Backend API URL
NEXT_PUBLIC_WEBAI_API_URL=http://localhost:8080

# Required: Admin key for tenant registration
NEXT_PUBLIC_WEBAI_ADMIN_KEY=your-secure-admin-key-here

# Optional: Enable debug logging
NEXT_PUBLIC_WEBAI_DEBUG=false

# Optional: App branding
NEXT_PUBLIC_APP_NAME=WebAI Chat
NEXT_PUBLIC_APP_DESCRIPTION=AI Chat Assistant powered by WebAI